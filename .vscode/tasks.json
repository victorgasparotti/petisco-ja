{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "cppbuild",
      "label": "Petisco Ja: compilar main.c",
      "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "${workspaceFolder}\\main.c",
        "-I", "C:\\msys64\\ucrt64\\include",
        "-I", "C:\\msys64\\ucrt64\\include\\mariadb",
        "-o", "${workspaceFolder}\\main.exe",
        "-L", "C:\\msys64\\ucrt64\\lib",
        "-lmariadb",
        "-lws2_32"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\msys64\\ucrt64\\bin;C:\\msys64\\usr\\bin;${env:PATH}"
        }
      },
      "problemMatcher": ["$gcc"],
      "group": {"kind": "build", "isDefault": true},
      "detail": "Compila o sistema Petisco Ja integrado ao MariaDB/MySQL"
    }
  ]
}
