{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug PetiscoJa",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\app.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "C:\\msys64\\ucrt64\\bin;C:\\msys64\\usr\\bin;${env:PATH}"
        },
        {
          "name": "PETISCO_DB_PASSWORD",
          "value": "${input:senhaMySQL}"
        }
      ],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
      "preLaunchTask": "C/C++: gcc.exe build active file"
    }
  ],
  "inputs": [
    {
      "id": "senhaMySQL",
      "type": "promptString",
      "description": "Digite a senha do MySQL para esta execucao",
      "password": true
    }
  ]
}
